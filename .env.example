# ==============================================================================
# Real-Time 3D Vehicle Suspension Simulator — Environment Configuration Template
# ==============================================================================
# COPY this file to .env and set your local or production values.
# NEVER commit real secret keys, credentials, or .env files to source control!
# ==============================================================================

# Server Runtime Environment (production | development)
SIMULATOR_ENV=production

# Server Port (default: 8000)
PORT=8000

# Administrative API Key
# Used for protected endpoints such as /api/admin/status and /api/export_plots
# Generate a secure 32+ character hex or alphanumeric string (e.g. `openssl rand -hex 24`)
ADMIN_API_KEY=replace_with_a_secure_random_admin_api_key_32_chars_min

# Allowed CORS Origins (comma-separated URLs)
# Restricts cross-origin browser requests to trusted domains
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting Configuration (requests per minute per client IP)
RATE_LIMIT_STANDARD_RPM=60
RATE_LIMIT_EXPORT_RPM=5
